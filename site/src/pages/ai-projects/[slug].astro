---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { aiProjects } from '../../data/site';
export function getStaticPaths() { return aiProjects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.summary}><div class="shell"><ProjectDetail project={project} /></div></BaseLayout>
