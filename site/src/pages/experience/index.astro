---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { education, experiences, site } from '../../data/site';
---
<BaseLayout title="经历"><section class="page-header"><div class="shell"><p class="eyebrow">EXPERIENCE</p><h1>经历</h1><p>教育背景、实习经历、产品职责与可确认结果。</p></div></section><section class="section"><div class="shell"><p class="eyebrow">EDUCATION</p><h2>学习路径</h2><div class="timeline">{education.map((item) => <article><p class="meta">{item.period}</p><h3>{item.school}</h3><p>{item.degree}</p><p>{item.note}</p></article>)}</div></div></section><section class="section section--sky"><div class="shell"><p class="eyebrow">INTERNSHIP</p><h2>实习时间线</h2><div class="timeline">{experiences.map((item) => <details id={item.id}><summary><span class="meta">{item.period}</span><br />{item.company} · {item.role}</summary><h3>{item.focus}</h3><p>{item.summary}</p><ul class="detail-list">{item.work.map((work) => <li>{work}</li>)}</ul><ul class="metric-list">{item.metrics.map((metric) => <li>{metric}</li>)}</ul></details>)}</div><div class="button-row"><a class="button" href="/ai-projects/">查看AI项目</a><a class="button button--secondary" href={site.resume} download>下载简历</a></div></div></section></BaseLayout>
