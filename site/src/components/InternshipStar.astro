---
interface Props { id: string; }
const { id } = Astro.props;
const stories: Record<string, {s: string; t: string; a: string; r: string}> = {
  tencent: {
    s: '妙思智投的AIGC广告策略需要扩大行业覆盖，并打通素材生产、入库与实际投放，提升AIGC广告消耗。',
    t: '负责AIGC投放链路与供给利用漏斗分析，参与生成策略和评测体系设计，协同相关团队推进接入、灰度验证与行业推广。',
    a: '将目标拆解为覆盖、开启、供给、利用和效果五个环节，通过看板定位瓶颈；建设跨团队SOP及商品粒度视频裂变策略，对前贴与成片分别评测，以商品事实和合规性为门槛，依据Badcase调整输入、Prompt和剪辑衔接规则。',
    r: '推动策略覆盖4个行业，原声混剪覆盖率100%，开启率达到25%，日耗从1w提升至10w；相关视频策略素材可用率达到95%后上线智投。',
  },
  surveyx: {
    s: '文献综述的一键生成耗时长、过程不可控，用户难以在生成中途调整结果。',
    t: '负责用户反馈整理、生成链路优化及埋点漏斗分析，参与质量评估与交互改进。',
    a: '基于50+用户反馈，将流程拆为标题、关键词、大纲、文献检索与最终生成；结合埋点定位文献筛选与等待阶段的流失，优化筛选交互和状态展示；邀请10+博士生评估内容与引用质量。',
    r: '用户完整体验率提升30%，日活增加到300+；问卷反馈显示用户满意度提升28%。',
  },
  'sjtu-ai-companion': {
    s: '语音情绪陪伴与佛学知识问答需要同时理解语义和情绪，并对不同风险表达采取合适的回复。',
    t: '承担语音交互研究、Web原型与用户测试方案设计，参与知识库、Agent决策流程和效果评估。',
    a: '针对情绪与语义不一致设计3类情绪标注，联合心理咨询师归纳100+问题和10+痛点；整理知识语料、结构化问答及角色数据，结合向量检索与阈值过滤，按一般咨询、负面情绪和高风险表达配置回复策略。',
    r: '完成交互原型、知识数据与对话决策流程；模型验证中佛学知识准确率79%，角色一致性89%。',
  },
  yuewen: {
    s: '推文KOL需要批量制作网文推广素材，创作链路需要兼顾效率、人物一致性和投放要求。',
    t: '参与从0到1搭建漫剪创作平台，承担创作链路设计、模型选型评测与基于采纳和投放数据的策略优化。',
    a: '设计书籍输入、角色抽取、脚本、分镜、生图或视频生成到人工编辑导出的流程，接入风控预审；围绕图像与文本建立评测标准，协同算法完成20+LoRA评测迭代，结合素材采纳率及投放数据进行归因。',
    r: '平台日活100+、注册人数2000+；文生图可用率提升30%，文本生成不可用率降至1%，单张图片修改率降至10%以下，最佳案例用户转化率达到16%。',
  },
};
const story = stories[id];
---
{story && <section aria-label="实习STAR总结" class="internship-star">
  <h4>STAR 实习总结</h4>
  <div class="star-grid">
    <article><span class="star-label">S / 情境</span><p>{story.s}</p></article>
    <article><span class="star-label">T / 任务</span><p>{story.t}</p></article>
    <article><span class="star-label">A / 行动</span><p>{story.a}</p></article>
    <article><span class="star-label">R / 结果</span><p>{story.r}</p></article>
  </div>
</section>}
